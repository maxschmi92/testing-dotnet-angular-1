{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api",
  "tags": ["scope:api", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/apps/api-tests/**/*"],
      "options": {
        "command": "dotnet build apps/api/Api.slnx -c Release"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "dotnet watch --project apps/api/Api.csproj run --launch-profile http"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/apps/api-tests/**/*"],
      "options": {
        "command": "dotnet test apps/api/Api.slnx"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/apps/api-tests/**/*"],
      "options": {
        "command": "dotnet format apps/api/Api.slnx --verify-no-changes"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet format apps/api/Api.slnx"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "command": "dotnet publish apps/api/Api.csproj -c Release -o dist/apps/api"
      }
    },
    "ef-migrations-add": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet ef migrations add {args.name} --project apps/api/Api.csproj --startup-project apps/api/Api.csproj --output-dir Migrations"
      }
    },
    "ef-database-update": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet ef database update --project apps/api/Api.csproj --startup-project apps/api/Api.csproj"
      }
    }
  }
}
