# Copy to `.env` and adjust. Only `.env.example` is committed; `.env` is git-ignored.
# Used by docker-compose.yml (the full container stack).

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=angular_dotnet

# --- Host ports for the full stack ---
ADMIN_PORT=4200
CLIENT_PORT=4201
API_PORT=5080
