# Copy to launch.env (git-ignored) and fill in. Discover the OCIDs with the
# commands in README.md. OCIDs are identifiers, not secrets, but launch.env is
# ignored so your specific account details stay out of git.

# Root compartment == your tenancy OCID (from ~/.oci/config, the `tenancy=` line).
COMPARTMENT_OCID=ocid1.tenancy.oc1..xxxxx

# The PUBLIC subnet created by the VCN wizard.
SUBNET_OCID=ocid1.subnet.oc1..xxxxx

# Ubuntu 22.04 aarch64 image for the A1 shape.
IMAGE_OCID=ocid1.image.oc1..xxxxx

# Space-separated availability-domain names to cycle through, e.g.
# ADS="tGgY:EU-FRANKFURT-1-AD-1 tGgY:EU-FRANKFURT-1-AD-2 tGgY:EU-FRANKFURT-1-AD-3"
ADS="AD-1 AD-2 AD-3"

# Path to the PUBLIC half of the deploy key you generated earlier.
SSH_PUBKEY_PATH=/home/baggio/.ssh/oracle_deploy.pub

# --- Optional (defaults shown) ---
DISPLAY_NAME=angular-dotnet
SHAPE=VM.Standard.A1.Flex
OCPUS=4
MEMORY_GB=24
BOOT_VOLUME_GB=50
SLEEP_SECONDS=60
